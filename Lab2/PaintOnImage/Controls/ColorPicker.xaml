<UserControl x:Class="PaintOnImage.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PaintOnImage.Controls"
             mc:Ignorable="d" Width="125" Height="50">
    <UniformGrid Columns="6">
        <Border Background="Black" MouseDown="Pick"/>
        <Border Background="Red" MouseDown="Pick"/>
        <Border Background="Green" MouseDown="Pick"/>
        <Border Background="Blue" MouseDown="Pick"/>
        <Border Background="Orange" MouseDown="Pick"/>
        <Border Background="Purple" MouseDown="Pick"/>
    </UniformGrid>
</UserControl>
