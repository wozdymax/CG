<Window x:Class="PaintOnImage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PaintOnImage"
        xmlns:uc="clr-namespace:PaintOnImage.Controls"
        mc:Ignorable="d"
        Title="Image Painter" Height="753" Width="1060">
    <DockPanel>

        <!-- MENU -->
        <Menu DockPanel.Dock="Top" HorizontalAlignment="Stretch" Margin="0,0,0,0" Width="NaN">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Click="New_Click"/>
                <MenuItem Header="_Open" Click="Open_Click"/>
                <MenuItem Header="_Save As" Click="Save_Click"/>
                <Separator/>
                <MenuItem Header="_Exit" Click="Exit_Click"/>
            </MenuItem>
        </Menu>

        <!-- COLOR PICKER -->
        <Border DockPanel.Dock="Left" 
                Padding="5"
                Background="#EEE">
            <uc:ColorPicker ColorSelected="OnColorSelected" Margin="0,5,0,654" Width="125"/>
        </Border>

        <!-- DRAW AREA -->
        <Canvas x:Name="Canvas"
                Background="White"
                MouseDown="Down"
                MouseMove="Move"
                MouseUp="Up"/>
    </DockPanel>
</Window>
